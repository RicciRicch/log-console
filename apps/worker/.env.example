# Worker čita promenljive iz root .env fajla (lokalno) ili iz Railway podešavanja (server).
# Ovo su TAJNE: nikad u git, nikad u apps/web.

# Supabase dashboard → Connect → Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<lozinka>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Za kasnije poslove (čitanje ključa kurira iz Vault-a kroz get_courier_secret)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role ključ>

LOG_LEVEL=info
# HEALTH_CRON=*/15 * * * *
